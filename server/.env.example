# HTTP port of the server
PORT=3000
# Allowed CORS origin (client URL)
CORS_ORIGIN=http://localhost:5173
# Session JWT secret
JWT_SECRET=
# Key with SIGNER_ROLE on the RewardVault (KMS/HSM in production; NEVER commit)
SIGNER_KEY=
# Contract addresses and chain
VAULT_ADDRESS=
HEROES_ADDRESS=
HOUSES_ADDRESS=
CHAIN_ID=31337
# RPC to read on-chain contracts (Robinhood Chain testnet or local node)
RPC_URL=
# SQLite database path (default: ./minerblast.db); ":memory:" for tests
DATABASE_PATH=./minerblast.db
# Key for the /admin/metrics administrative endpoint
ADMIN_KEY=
# Withdrawal rules — MUST mirror the on-chain vault (setMinClaim/setClaimCooldown)
# Production target: 60000 / 24; testnet beta: 750 / 1
MIN_CLAIM_BLAST=60000
CLAIM_COOLDOWN_HOURS=24
