# Porta HTTP do servidor
PORT=3000
# Origem permitida no CORS (URL do cliente)
CORS_ORIGIN=http://localhost:5173
# Segredo do JWT de sessão
JWT_SECRET=
# Chave com SIGNER_ROLE no RewardVault (KMS/HSM em produção; NUNCA commitar)
SIGNER_KEY=
# Endereços dos contratos e chain
VAULT_ADDRESS=
HEROES_ADDRESS=
HOUSES_ADDRESS=
CHAIN_ID=31337
# RPC para ler contratos on-chain (testnet Robinhood Chain ou nó local)
RPC_URL=
# Caminho do banco SQLite (default: ./minerblast.db); ":memory:" para testes
DATABASE_PATH=./minerblast.db
# Chave do endpoint administrativo /admin/metrics
ADMIN_KEY=
