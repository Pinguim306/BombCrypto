[gd_resource type="Theme" load_steps=7 format=3]

[ext_resource type="FontFile" path="res://assets/fonts/DejaVuSansMono.ttf" id="1_mono"]
[ext_resource type="FontFile" path="res://assets/fonts/DejaVuSansMono-Bold.ttf" id="2_bold"]
[ext_resource type="FontFile" path="res://assets/fonts/DejaVuSans.ttf" id="3_sans"]

[sub_resource type="FontVariation" id="FontVariation_mono"]
base_font = ExtResource("1_mono")
fallbacks = Array[Font]([ExtResource("3_sans")])

[sub_resource type="FontVariation" id="FontVariation_bold"]
base_font = ExtResource("2_bold")
fallbacks = Array[Font]([ExtResource("3_sans")])

[sub_resource type="StyleBoxEmpty" id="StyleBoxEmpty_none"]

[resource]
default_font = SubResource("FontVariation_mono")
default_font_size = 13
BoldLabel/base_type = &"Label"
BoldLabel/fonts/font = SubResource("FontVariation_bold")
JuiceButton/base_type = &"Button"
