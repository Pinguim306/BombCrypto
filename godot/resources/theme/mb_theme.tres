JuiceButton/styles/disabled = SubResource("StyleBoxEmpty_none")
JuiceButton/styles/focus = SubResource("StyleBoxEmpty_none")
JuiceButton/styles/hover = SubResource("StyleBoxEmpty_none")
JuiceButton/styles/hover_pressed = SubResource("StyleBoxEmpty_none")
JuiceButton/styles/normal = SubResource("StyleBoxEmpty_none")
JuiceButton/styles/pressed = SubResource("StyleBoxEmpty_none")
Label/colors/font_color = Color(0.925, 0.937, 0.945, 1)
StageCard/base_type = &"Button"
StageCard/styles/disabled = SubResource("StyleBoxEmpty_none")
StageCard/styles/focus = SubResource("StyleBoxEmpty_none")
StageCard/styles/hover = SubResource("StyleBoxEmpty_none")
StageCard/styles/hover_pressed = SubResource("StyleBoxEmpty_none")
StageCard/styles/normal = SubResource("StyleBoxEmpty_none")
StageCard/styles/pressed = SubResource("StyleBoxEmpty_none")
