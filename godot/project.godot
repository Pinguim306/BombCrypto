; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="MinerBlast"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/show_image=false
boot_splash/bg_color=Color(0.0627, 0.0784, 0.1216, 1)
config/icon="res://icon.svg"

[autoload]

Config="*res://scripts/autoload/config.gd"
Juice="*res://scripts/autoload/juice.gd"
Sfx="*res://scripts/autoload/sfx.gd"
Backend="*res://scripts/autoload/backend.gd"
GameState="*res://scripts/autoload/game_state.gd"

[debug]

gdscript/warnings/untyped_declaration=1
gdscript/warnings/unsafe_property_access=1

[display]

window/size/viewport_width=960
window/size/viewport_height=540
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"
window/stretch/scale_mode="fractional"
window/dpi/allow_hidpi=true

[gui]

theme/custom="res://resources/theme/mb_theme.tres"
theme/default_font_antialiasing=0
theme/default_font_hinting=2
theme/default_font_subpixel_positioning=0
fonts/dynamic_fonts/use_oversampling=false
common/snap_controls_to_pixels=true

[importer_defaults]

texture={
"compress/mode": 0,
"mipmaps/generate": false,
"detect_3d/compress_to": 0,
"process/fix_alpha_border": true
}

[input_devices]

pointing/emulate_mouse_from_touch=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
renderer/rendering_method.web="gl_compatibility"
textures/canvas_textures/default_texture_filter=1
textures/canvas_textures/default_texture_repeat=0
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=false
2d/shadow_atlas/size=1024
viewport/hdr_2d=false
environment/defaults/default_clear_color=Color(0.0627, 0.0784, 0.1216, 1)
limits/opengl/max_renderable_lights=24
limits/opengl/max_lights_per_object=4

[audio]

general/default_playback_type.web=1
