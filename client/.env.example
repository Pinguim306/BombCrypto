# Game server URL
VITE_SERVER_URL=http://localhost:3000
# Network shown to players (docs pages, footer). Public launch:
#   "Robinhood Chain Mainnet"; private beta: "Robinhood Chain Testnet"
VITE_NETWORK_NAME=Robinhood Chain Mainnet
# Chain params for this deployment (testnet beta: 46630 + testnet RPC;
# mainnet values are announced at the Robinhood Chain mainnet launch)
VITE_CHAIN_ID=
VITE_RPC_URL=
# Contract addresses (output of the deploy script)
VITE_TOKEN_ADDRESS=
VITE_VAULT_ADDRESS=
VITE_MARKET_ADDRESS=
VITE_HEROES_ADDRESS=
VITE_HOUSES_ADDRESS=
VITE_GACHA_ADDRESS=
# Official $BLAST contract address shown in the site header (set on Vercel at TGE;
# falls back to VITE_TOKEN_ADDRESS when empty)
VITE_BLAST_CA=
